                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "v1hSZs",
                      "name": "Manchete",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Selic parada, mas o Copom já fala em novembro: o que muda para quem tem dívida, poupança e financiamento",
                      "lineHeight": 1.12,
                      "fontFamily": "$font-display",
                      "fontSize": 27,
                      "fontWeight": "800"
                    },
                    {
                      "type": "text",
                      "id": "SDmJB",
                      "name": "Linha Fina",
                      "fill": "$ink-soft",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Comitê manteve a taxa em 12,25% pela terceira vez, mas retirou do comunicado a expressão “por período prolongado”. Bancos leram o sinal como início do ciclo de cortes.",
                      "lineHeight": 1.35,
                      "fontFamily": "$font-serif",
                      "fontSize": 15,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
                    },
                    {
                      "type": "frame",
                      "id": "z17R1I",
                      "name": "Colunas Brasil",
                      "width": "fill_container",
                      "gap": 22,
                      "children": [
                        {
                          "type": "frame",
                          "id": "EnHGp",
                          "name": "Col 1",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 10,
                          "children": [
                            {
                              "type": "text",
                              "id": "j8vT0B",
                              "name": "Parágrafo",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "BRASÍLIA — A decisão de ontem à noite era a mais esperada do ano pelo mercado, e por um motivo curioso: não pelo que o Comitê de Política Monetária faria, mas pelo que diria. A Selic ficou em 12,25% ao ano, como todos previam. A mudança estava no texto.",
                              "lineHeight": 1.45,
                              "fontFamily": "$font-serif",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "gEQZj",
                              "name": "Parágrafo",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "O comunicado deixou de dizer que a taxa ficaria alta “por período prolongado”. No lugar, o comitê afirma que “avaliará os próximos passos com base na consolidação do processo de desinflação”. Em linguagem de banco central, isso significa que a porta para cortes está aberta.",
                              "lineHeight": 1.45,
                              "fontFamily": "$font-serif",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "p3Tsx",
                              "name": "Parágrafo",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Os números ajudam. A inflação de serviços, que preocupava o comitê desde o começo do ano, desacelerou por três meses seguidos. As expectativas do mercado para 2027 recuaram para 3,6%, mais perto do centro da meta.",
                              "lineHeight": 1.45,
                              "fontFamily": "$font-serif",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "xxhk8",
                          "name": "Col 2",
                          "width": "fill_container",
                          "layout": "vertical",
                          "gap": 10,
                          "children": [
                            {
                              "type": "text",
                              "id": "wvVyE",
                              "name": "Parágrafo",
                              "fill": "$ink",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Para o consumidor, o efeito não é imediato. Um corte de 0,25 ponto em novembro, o cenário mais provável segundo o boletim Focus, reduz o custo de um financiamento imobiliário de 30 anos em cerca de 1% do valor total das parcelas. É pouco no mês, mas relevante ao longo do contrato.",
                              "lineHeight": 1.45,
                              "fontFamily": "$font-serif",
                              "fontSize": 14,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "frame",
                              "id": "LqMh9",
                              "name": "Citação",
                              "width": "fill_container",
                              "stroke": "$rule",
