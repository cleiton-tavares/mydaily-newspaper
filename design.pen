                                14
                              ],
                              "children": [
                                {
                                  "type": "text",
                                  "id": "Zp8QQ",
                                  "name": "Citação Texto",
                                  "fill": "$ink",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "A vantagem dos modelos fechados sempre foi de meses, nunca de anos. Agora é de semanas.",
                                  "lineHeight": 1.3,
                                  "fontFamily": "$font-display",
                                  "fontSize": 17,
                                  "fontWeight": "600",
                                  "fontStyle": "italic"
                                },
                                {
                                  "type": "text",
