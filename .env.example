# =========================================================================
#  Credenciais do proxy LiteLLM (obrigatório)
#  Copie este arquivo para `.env` e preencha com os seus valores.
#  O LiteLLM expõe uma API compatível com a OpenAI, então basta a URL base
#  do proxy + a sua chave + o nome do modelo configurado no proxy.
# =========================================================================

# URL base do seu proxy LiteLLM (sem o /chat/completions no final).
# Ex.: http://localhost:4000  ou  https://litellm.suaempresa.com
LITELLM_BASE_URL=http://localhost:4000

# Chave de API do LiteLLM (o "master key" ou uma virtual key).
LITELLM_API_KEY=sk-sua-chave-aqui

# Nome do modelo, exatamente como está registrado no seu proxy LiteLLM.
# Ex.: gpt-4o, claude-sonnet, gemini-1.5-pro, etc.
LITELLM_MODEL=gpt-4o

# (Opcional) Caminho para o executável do Chromium usado pelo Playwright.
# Deixe em branco no seu computador depois de rodar `playwright install chromium`.
# PLAYWRIGHT_CHROMIUM_PATH=

# (Opcional) Google Calendar — método ICS.
# URL secreta iCal do seu calendário. É um segredo, por isso fica aqui e não no
# config.yaml. Habilite google_calendar.ativar: true no config.yaml.
# GOOGLE_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
